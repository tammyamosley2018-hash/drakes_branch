# NEVER COMMIT — this repository is public.
# ---------------------------------------------------------------------------
# A WordPress database dump holds user accounts, email addresses and password
# hashes. The site backup holds wp-config.php, which holds live database
# credentials. Publishing either would be a serious data breach.

*.sql
*.sql.gz
*.zip
public_html/
wp-config.php
.htaccess
*.pem
*.key
.env
.env.*

